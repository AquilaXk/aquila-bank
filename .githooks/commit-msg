#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"
[ -f "$msg_file" ] || exit 0

# Strip AI agent attribution / watermark
tmp="$(mktemp)"
grep -Eiv \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor([[:space:]]|<|$)' \
  -e 'cursoragent@cursor\.com' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor[[:space:]]*$' \
  -e '^[[:space:]]*Made with Cursor[[:space:]]*$' \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Claude' \
  -e 'noreply@anthropic\.com' \
  -e '^[[:space:]]*Generated with \[?Claude Code\]?' \
  -e '^[[:space:]]*🤖[[:space:]]*Generated with' \
  "$msg_file" > "$tmp" || true
mv "$tmp" "$msg_file"

subject="$(head -n 1 "$msg_file" | tr -d '\r')"

if [[ "$subject" =~ ^Merge\  ]] || [[ "$subject" =~ ^Revert\  ]] || [[ "$subject" =~ ^fixup!\  ]] || [[ "$subject" =~ ^squash!\  ]]; then
  exit 0
fi

if ! [[ "$subject" =~ ^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)(\([a-z0-9][a-z0-9._/-]*\))?!?:\ .+$ ]]; then
  cat >&2 <<'EOF'
[commit-msg] 커밋 메시지 규칙 위반!
형식: <type>(<scope>): <summary> 또는 <type>: <summary>
예시1: feat(transaction): implement keyset pagination cursor
예시2: fix(account): prevent concurrent overdraft race condition
예시3: docs(readme): update verification gate commands
허용 타입: feat, fix, refactor, chore, docs, style, test, perf, build, ci, revert, hotfix
권장 사항: 영문 명령형 동사(Imperative verb) 사용, 제목 72자 이내
EOF
  exit 1
fi

summary="${subject#*: }"
if [[ ${#subject} -gt 72 ]]; then
  echo "[commit-msg] Warning: commit subject exceeds 72 characters (${#subject} chars)" >&2
fi
