#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"
[ -f "$msg_file" ] || exit 0

# Strip AI agent attribution / watermark
tmp="$(mktemp)"
grep -Eiv \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor([[:space:]]|<|$)' \
  -e 'cursoragent@cursor\.com' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor[[:space:]]*$' \
  -e '^[[:space:]]*Made with Cursor[[:space:]]*$' \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Claude' \
  -e 'noreply@anthropic\.com' \
  -e '^[[:space:]]*Generated with \[?Claude Code\]?' \
  -e '^[[:space:]]*🤖[[:space:]]*Generated with' \
  "$msg_file" > "$tmp" || true
mv "$tmp" "$msg_file"

subject="$(head -n 1 "$msg_file" | tr -d '\r')"

if [[ "$subject" =~ ^Merge\  ]] || [[ "$subject" =~ ^Revert\  ]] || [[ "$subject" =~ ^fixup!\  ]] || [[ "$subject" =~ ^squash!\  ]]; then
  exit 0
fi

if ! [[ "$subject" =~ ^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)(\([a-z0-9][a-z0-9._/-]*\))?!?:\ .+$ ]] \
  && ! [[ "$subject" =~ ^\[(Feat|Fix|Refactor|Chore|Docs|Style|Test|Perf|Build|CI|Revert|Hotfix)\]\ .+$ ]]; then
  cat >&2 <<'EOF'
[commit-msg] 커밋 메시지 규칙 위반!
형식: [<Type>] <summary> 또는 <type>(<scope>): <summary> 또는 <type>: <summary>
예시1: [Perf] 거래 커서 HMAC 상수 시간 워드 비교 및 쿼리 최적화
예시2: feat(transaction): implement keyset pagination cursor
예시3: fix(account): prevent concurrent overdraft race condition
허용 타입: Feat/feat, Fix/fix, Refactor/refactor, Chore/chore, Docs/docs, Style/style, Test/test, Perf/perf, Build/build, CI/ci, Revert/revert, Hotfix/hotfix
권장 사항: 제목 72자 이내
EOF
  exit 1
fi

summary="${subject#*: }"
if [[ ${#subject} -gt 72 ]]; then
  echo "[commit-msg] Warning: commit subject exceeds 72 characters (${#subject} chars)" >&2
fi
