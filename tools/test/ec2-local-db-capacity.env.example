# Local-only EC2 App + Mac Docker PostgreSQL 100m capacity template.
# Copy outside git, fill secrets/runtime values, then pass with EC2_LOCAL_DB_CAPACITY_ENV_FILE.

export EC2_CAPACITY_RUN_ID=ec2-local-db-100m-$(date +%Y-%m-%d-%H%M%S)

# Runner endpoints. Use 127.0.0.1 when running on the EC2 host, or public URL from local.
export EC2_DIRECT_BACKEND_BASE_URL=http://127.0.0.1:18080
export EC2_NGINX_BASE_URL=http://127.0.0.1

# Prod profile requires a real fixture JWT or a separately constrained loadtest profile.
export EC2_LOADTEST_AUTH_REQUIRED=true
export EC2_LOADTEST_AUTH_TOKEN=<fixture-jwt-or-limited-loadtest-token>

# 100m fixture account/window contract.
export EC2_K6_HOT_ACCOUNT_ID=910000001
export EC2_K6_HOT_FROM=2026-04-01T00:00:00Z
export EC2_K6_HOT_TO=2026-04-30T00:00:00Z
export EC2_K6_COLD_ACCOUNT_ID=910000002
export EC2_K6_COLD_FROM=2026-01-01T00:00:00Z
export EC2_K6_COLD_TO=2026-01-31T00:00:00Z

# Backend container -> EC2 host-gateway -> local Mac Docker PostgreSQL tunnel.
export EC2_DOCKER_NETWORK=aquila-bank-prod
export EC2_LOCAL_DB_TUNNEL_CHECK=true
export EC2_LOCAL_DB_PROBE_IMAGE=postgres:18-alpine
export EC2_LOCAL_DB_HOST=host.docker.internal
export EC2_LOCAL_DB_PORT=25432
export EC2_LOCAL_DB_NAME=aquila_bank
export EC2_LOCAL_DB_USER=postgres
export EC2_LOCAL_DB_PASSWORD=<local-db-password>

# Optional CloudWatch/Docker snapshot targets.
export EC2_CAPACITY_AWS_REGION=ap-northeast-2
export EC2_CAPACITY_EC2_INSTANCE_ID=<ec2-instance-id>
export EC2_CAPACITY_EBS_VOLUME_ID=<root-ebs-volume-id>
