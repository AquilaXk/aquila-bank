# GitHub Environment: production
# Copy to tools/ops/production-github-environment.env and replace secret placeholders locally.
# Do not commit real token, password, webhook, or production URL values.

# Required environment secrets
# OCI_A1_PRODUCTION_ENV stores the shell env file consumed by production-promotion.yml.
# Set OCI_A1_PRODUCTION_ENV directly, or set OCI_A1_PRODUCTION_ENV_FILE to a local file path.
OCI_A1_PRODUCTION_ENV="<required-oci-a1-production-env-content>"
OCI_A1_PRODUCTION_ENV_FILE=

# Alertmanager receiver secrets
ALERTMANAGER_RECEIVER_SLACK_ENABLED=false
ALERTMANAGER_RECEIVER_SLACK_WEBHOOK_URL="<required-if-slack-enabled>"
ALERTMANAGER_RECEIVER_PAGERDUTY_ENABLED=false
ALERTMANAGER_RECEIVER_PAGERDUTY_ROUTING_KEY="<required-if-pagerduty-enabled>"
ALERTMANAGER_RECEIVER_WEBHOOK_ENABLED=false
ALERTMANAGER_RECEIVER_WEBHOOK_URL="<required-if-webhook-enabled>"
ALERTMANAGER_RECEIVER_TELEGRAM_ENABLED=true
ALERTMANAGER_RECEIVER_TELEGRAM_BOT_TOKEN="<required-if-telegram-enabled>"
ALERTMANAGER_RECEIVER_TELEGRAM_CHAT_ID="<required-if-telegram-enabled>"

# Required production promotion secrets
REDIS_HOST="<required-if-redis-throttling>"
TRANSACTION_READ_REPLICA_URL="<required-if-read-replica-enabled>"
TRANSACTION_READ_REPLICA_USERNAME="<required-if-read-replica-enabled>"
TRANSACTION_READ_REPLICA_PASSWORD="<required-if-read-replica-enabled>"
OUTBOX_KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
NOTIFICATION_INBOX_CONSUMER_BOOTSTRAP_SERVERS="kafka:9092"
PRODUCTION_BASE_URL="<required-production-base-url>"
PRODUCTION_SMOKE_SHA_PATH=/actuator/info
PRODUCTION_SMOKE_HEALTH_PATH=/actuator/health
PRODUCTION_SMOKE_READ_PATH=/actuator/health/readiness
PRODUCTION_SMOKE_WRITE_PATH="<required-production-safe-write-smoke-path>"
PRODUCTION_SMOKE_WRITE_METHOD=POST
PRODUCTION_SMOKE_WRITE_BODY={}
PRODUCTION_SMOKE_AUTH_HEADER_NAME="<required-if-smoke-auth-enabled>"
PRODUCTION_SMOKE_AUTH_HEADER_VALUE="<required-if-smoke-auth-enabled>"
PRODUCTION_SMOKE_TIMEOUT_SECONDS=5

# Optional rollback hook secrets. Leave empty to disable rollback dispatch.
PRODUCTION_ROLLBACK_WEBHOOK_URL=
PRODUCTION_ROLLBACK_TOKEN=
PRODUCTION_ROLLBACK_TARGET_SHA=

# Production environment variables
SECURITY_LOGIN_THROTTLING_STORE=memory
SECURITY_LOGIN_THROTTLING_REQUIRE_REDIS=false
REDIS_PORT=6379
TRANSACTION_READ_REPLICA_ENABLED=false
TRANSACTION_READ_REPLICA_POOL_MAX_SIZE=2
TRANSACTION_READ_REPLICA_LAG_THRESHOLD_MS=1000
OUTBOX_KAFKA_ENABLED=true
OUTBOX_KAFKA_TOPIC_DEFAULT=bank.notification.outbox.v1
OUTBOX_KAFKA_TOPIC_TRANSFER_BOOKED=bank.transfer.booked.v1
OUTBOX_KAFKA_TOPIC_TRANSFER_REVERSED=bank.transfer.reversed.v1
OUTBOX_KAFKA_PRODUCER_ACKS=all
OUTBOX_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
OUTBOX_KAFKA_PRODUCER_MAX_IN_FLIGHT=1
NOTIFICATION_INBOX_CONSUMER_ENABLED=true
NOTIFICATION_INBOX_CONSUMER_OPS_ENABLED=true
NOTIFICATION_INBOX_CONSUMER_CONCURRENCY=1
NOTIFICATION_INBOX_CONSUMER_TRANSFER_BOOKED_TOPIC=bank.transfer.booked.v1
NOTIFICATION_INBOX_CONSUMER_TRANSFER_REVERSED_TOPIC=bank.transfer.reversed.v1
NOTIFICATION_INBOX_CONSUMER_DLQ_TOPIC=bank.notification.inbox.dlq.v1
KAFKA_TOPIC_PROVISIONING_ENABLED=true
KAFKA_TOPIC_STARTUP_VALIDATION_ENABLED=true
KAFKA_TOPIC_PROVISIONING_PARTITIONS=1
KAFKA_TOPIC_PROVISIONING_REPLICATION_FACTOR=1
KAFKA_TOPIC_PROVISIONING_MIN_IN_SYNC_REPLICAS=1
OPS_API_ADMISSION_CONTROL_ENABLED=true
OPS_API_ADMISSION_CONTROL_TRANSACTION_READ_MAX=3
OPS_API_ADMISSION_CONTROL_ACCOUNT_READ_MAX=4
OPS_API_ADMISSION_CONTROL_TRANSFER_WRITE_MAX=2
OPS_API_ADMISSION_CONTROL_NOTIFICATION_STREAM_MAX=4
OPS_API_ADMISSION_CONTROL_NOTIFICATION_READ_MAX=4
OPS_API_ADMISSION_CONTROL_INTERNAL_OPS_MAX=2
OPS_T3MICRO_SATURATION_GUARD_ENABLED=true
OPS_T3MICRO_SATURATION_GUARD_POOL_ACTIVE_THRESHOLD_PERCENT=90
OPS_T3MICRO_SATURATION_GUARD_THREADS_BUSY_THRESHOLD_PERCENT=90
OPS_T3MICRO_SATURATION_GUARD_QUERY_TIMEOUT_THRESHOLD=1
DB_POOL_MAX_SIZE=4
SERVER_THREADS_MAX=16
NOTIFICATION_SSE_MAX_TOTAL_SESSIONS=64
