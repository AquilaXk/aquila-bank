NGINX_SERVER_NAME=bank.example.com
NGINX_SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/bank.example.com/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/bank.example.com/privkey.pem
NGINX_FRONTEND_SERVER=127.0.0.1:3000
NGINX_BACKEND_API_SERVERS=127.0.0.1:8080
NGINX_BACKEND_API_KEEPALIVE_TIMEOUT_SECONDS=2
NGINX_EDGE_RETRY_AFTER_SECONDS=1
NGINX_EDGE_RETRY_AFTER_MILLIS=150
NGINX_EDGE_RETRY_JITTER_MILLIS=100
NGINX_REAL_IP_HEADER=X-Forwarded-For
NGINX_REAL_IP_TRUSTED_PROXIES=10.60.0.0/16
NGINX_TRANSACTION_READ_HOT_RATE_RPS=96
NGINX_TRANSACTION_READ_ARCHIVE_RATE_RPS=96
NGINX_TRANSACTION_READ_HOT_BURST=12
NGINX_TRANSACTION_READ_ARCHIVE_BURST=12
NGINX_TRANSACTION_READ_HOT_DELAY=1
NGINX_TRANSACTION_READ_ARCHIVE_DELAY=1
# multi-node 예시:
# NGINX_BACKEND_API_SERVERS=10.0.1.11:8080,10.0.1.12:8080
# 비우면 API upstream과 같은 pool을 재사용합니다.
# NGINX_BACKEND_SSE_SERVERS=10.0.1.11:8080,10.0.1.12:8080
# OCI paid A1 기본 VCN은 10.60.0.0/16입니다. LB/CDN subnet을 더 좁게 알면 해당 CIDR로 교체합니다.
# TCP peer address 기준 limiter key로 되돌릴 때만 NGINX_REAL_IP_TRUSTED_PROXIES=none 을 사용합니다.
