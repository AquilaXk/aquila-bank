OUTBOX_POLLER_INITIAL_DELAY_MS=3000
OUTBOX_POLLER_BATCH_SIZE=20
OUTBOX_POLLER_STALE_AFTER_SECONDS=30
OUTBOX_POLLER_MAX_RETRY_DELAY_SECONDS=60
OUTBOX_POLLER_MAX_RETRY_ATTEMPTS=10
OUTBOX_KAFKA_ENABLED=false
